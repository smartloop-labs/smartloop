#  MCP connections, as a file describes them.
#
#  Drop a .toml file into  ~/.smartloop/mcp.d/  (or write ~/.smartloop/mcp.toml)
#  to add a connection without going through the UI. Files are read in name
#  order and merged, so an entry whose key matches an earlier one replaces it.
#  A file that fails to parse or validate is skipped with a logged reason; the
#  rest still load. See smartloop/mcp/definitions.py for the model each entry is
#  validated against, and smartloop/mcp/definition_loader.py for the merge.
#
#  Nothing here indexes anything. A connection's tools are enumerated once when
#  it is registered, and that list is what a request is resolved against; its
#  content is read by calling those tools when a question needs them.
#
#  ── A remote server ────────────────────────────────────────────────────────
#
#      [[mcp]]
#      name = "my-wiki"
#      url = "https://mcp.example.com/mcp"
#
#  OAuth is negotiated at install time. `token` is for the servers that take a
#  bearer token instead.
#
#  ── A server to run locally ────────────────────────────────────────────────
#
#      [[mcp]]
#      name = "yahoo-finance"
#      package = "yahoo-finance-mcp"
#
#      [[mcp]]
#      name = "my-node-mcp"
#      command = "npx"
#      args = ["-y", "@example/my-mcp"]
#
#  ── Fields ─────────────────────────────────────────────────────────────────
#
#  [[mcp]]
#    name            required. What the connection is called.
#    slug            optional. Defaults to `name`; set it to match the curated
#                    catalog slug a server was installed from.
#    match           extra substrings tried (case-insensitively) against an
#                    installed server's name, package and URL. `name` and `slug`
#                    are always tried, so this is for aliases.
#    url             a server reached over HTTP:
#                      url = "https://mcp.linear.app/mcp"
#    token           bearer token for a remote server that takes one.
#    package         a server to run locally, as a command line:
#                      package = "yahoo-finance-mcp"      # → uvx
#                      package = "npx -y @foo/bar-mcp"    # → npx, as written
#                      package = "python -m my.server"
#                    A bare name runs under `uvx` (the same thing typing it
#                    into "Add your own" does), except a scoped npm name
#                    (`@scope/pkg`), which can only be npm and runs under
#                    `npx -y`. Anything with a space in it is already a command
#                    line and is used as one — the launcher is never guessed
#                    past that.
#    command, args   the explicit form, used exactly as given. For a launcher
#    env, cwd        that takes flags, a module, or an absolute path:
#                      command = "npx"
#                      args = ["-y", "some-mcp"]
#                    `args` also accepts one string ("-y some-mcp"), split the
#                    way a shell would. A `command` carrying its own arguments
#                    ("npx -y some-mcp") is split too, with `args` appended.
#                    A url and a package name are alternatives: a server is
#                    reached over HTTP or run as a process, not both.
